# Coche de la 1.0: 4x4 con motor central y turbo, inspirado en el Peugeot 205 T16 Evo 1.
# Formato: secciones [nombre], "clave = valor", comentarios con #. Unidades SI salvo que la
# clave diga otra (_deg, _rpm, _bar). Ejes del coche: adelante -z, derecha +x, arriba +y; el origen
# está en el suelo, bajo el punto medio entre los ejes, con el coche en equilibrio.
# Origen de cada valor: "fuente" (datos publicados), "estimado" o "valor de partida". Los
# estimados y los de partida se ajustan en la tarea 2.10.

[chassis]
mass = 1100               # kg con dos ocupantes y combustible. Estimado (coche: 940-980 kg, fuente)
front_weight = 0.45       # reparto de peso delante/detrás 45/55. Fuente
wheelbase = 2.54          # m. Aproximado, verificar
track = 1.43              # m. Aproximado, verificar
cg_height = 0.45          # m sobre el suelo. Estimado
inertia_yaw = 1350        # kg·m². Estimado
inertia_pitch = 1250      # kg·m². Estimado
inertia_roll = 380        # kg·m². Estimado
box_length = 3.82         # m: caja de colisión de la carrocería. Aproximado
box_width = 1.70          # m. Aproximado
box_height = 1.17         # m: 1,35 m de alto total menos la altura libre. Aproximado
ground_clearance = 0.18   # m del suelo a la caja, en equilibrio. Estimado (grava)
cda = 0.75                # m². Estimado (sin carga aerodinámica)

[wheels]
radius = 0.31             # m. Estimado
width = 0.20              # m. Estimado
inertia = 1.2             # kg·m²: rueda, freno y palier. Estimado
footprint_length = 0.18   # m: largo de la huella. Estimado

[suspension]
travel = 0.20             # m de recorrido total. Estimado (grava)
frequency_front = 1.6     # Hz. Estimado (grava)
frequency_rear = 1.8      # Hz. Estimado (grava)
damping_ratio = 0.35      # fracción del crítico. Estimado
antiroll_front = 15000    # N/m. Estimado
antiroll_rear = 10000     # N/m. Estimado

# Durezas de la suspensión que elige el jugador (tarea 2.8): multiplicadores sobre la
# frecuencia del muelle, la fracción del crítico del amortiguador y la rigidez de las barras de
# [suspension]. La media es la de [suspension] (no es clave). Las tres quedan a la misma altura
# y con el mismo recorrido hasta el tope en parado (como ajustar la precarga). Valores de
# partida, se ajustan en 2.10.
[settings]
soft_frequency = 0.85
soft_damping = 0.9
soft_antiroll = 0.8
hard_frequency = 1.2
hard_damping = 1.15
hard_antiroll = 1.25

[brakes]
max_torque = 4400         # N·m total con el freno a fondo. Estimado (~1,3 g en asfalto)
front_share = 0.60        # fracción al eje delantero. Estimado
handbrake_torque = 1500   # N·m por rueda trasera. Estimado

[steering]
max_steer_deg = 30        # ángulo de la rueda interior. Estimado
ackermann = 0.5           # fracción de Ackermann. Estimado

# Neumático (tarea 2.5): Pacejka simplificada con una curva normalizada por superficie,
# fricción combinada por deslizamiento normalizado, sensibilidad a la carga, deformación de la
# huella como estado (relajación) y rodadura como par de Coulomb. Neumático de grava de rally,
# el mismo en todas las superficies. El lector calcula B y C de la curva al cargar.
# Lo común a todas las superficies:
[tire]
carcass_damping_long = 0.6 # ζ del modo carrocería-huella, longitudinal. Valor de partida, se ajusta en 2.10
carcass_damping_lat = 0.6 # ζ del modo carrocería-huella, lateral. Valor de partida, se ajusta en 2.10
carcass_damping_fade = 10 # m/s de v_ref = max(|v|, |ω|·r): el amortiguamiento de la carcasa baja a 0 aquí y el recorte de la huella llega a la rueda bloqueada a 75°. 2.5: quita el serpenteo de baja velocidad; ver 05. Se ajusta en 2.10

# Un juego por superficie. Claves:
#   mu_peak: μ pico a la carga estática media por rueda (F_z0 = m·g/4).
#   slip_angle_peak_deg y slip_ratio_peak: ángulo de deriva y deslizamiento longitudinal del
#   pico.
#   slide_ratio: μ deslizando / μ pico, la asíntota de la curva (entre 0,5 y 0,99).
#   curvature_e: E de la curva (< 1); mueve poco la caída tras el pico.
#   load_sensitivity: k en μ(F_z) = μ pico·(1 − k·(F_z/F_z0 − 1)), con F_z/F_z0 en [0, 3].
#   relaxation_lat y relaxation_long: σ_y y σ_x (m); σ_x = 0,375·σ_y, la proporción de la 2.4.
#   rolling_resistance: coeficiente × carga.
# Todos son valores de partida (tabla del prompt de la 2.5) y se ajustan en la 2.10.

# Mucho agarre, pico temprano, se va de golpe.
[tire.asphalt]
mu_peak = 1.10
slip_angle_peak_deg = 7
slip_ratio_peak = 0.10
slide_ratio = 0.80
curvature_e = 0
load_sensitivity = 0.10
relaxation_lat = 0.40
relaxation_long = 0.15
rolling_resistance = 0.015

# Agarra bastante y suelta con una caída marcada.
[tire.dirt]
mu_peak = 0.80
slip_angle_peak_deg = 10
slip_ratio_peak = 0.14
slide_ratio = 0.75
curvature_e = 0
load_sensitivity = 0.08
relaxation_lat = 0.50
relaxation_long = 0.1875
rolling_resistance = 0.030

# Flotante y progresiva: se desliza mucho sin perderse.
[tire.gravel]
mu_peak = 0.72
slip_angle_peak_deg = 14
slip_ratio_peak = 0.18
slide_ratio = 0.90
curvature_e = 0
load_sensitivity = 0.08
relaxation_lat = 0.60
relaxation_long = 0.225
rolling_resistance = 0.045

# Nieve con clavos: poco agarre, muy progresiva, frena poco.
[tire.snow]
mu_peak = 0.45
slip_angle_peak_deg = 12
slip_ratio_peak = 0.15
slide_ratio = 0.90
curvature_e = 0
load_sensitivity = 0.08
relaxation_lat = 0.60
relaxation_long = 0.225
rolling_resistance = 0.035

# Frena el coche; castiga perder las vueltas.
[tire.sand]
mu_peak = 0.50
slip_angle_peak_deg = 16
slip_ratio_peak = 0.22
slide_ratio = 0.95
curvature_e = 0
load_sensitivity = 0.08
relaxation_lat = 0.70
relaxation_long = 0.2625
rolling_resistance = 0.15

# Motor y transmisión (tarea 2.6; sim/drivetrain.h). Motor central transversal, 4 cilindros
# turbo (205 T16 Evo 1): 350 CV (257 kW) a 8000 rpm y ~450 N·m a 5000 rpm con presión.
[engine]
idle_rpm = 1000           # Estimado
limiter_rpm = 8200        # el corte llega a 0 aquí. Estimado
limiter_ramp_rpm = 100    # corte en rampa de 8100 a 8200 rpm (2.6: rampa en vez de rebote; el rebote, en el sonido de la 2.7)
inertia = 0.15            # kg·m² con volante y embrague. Estimado
friction = 0.072          # N·m·s/rad: freno motor ~60 N·m a 8000 rpm. Estimado
torque_scale = 1.0        # 1,0 = Evo 1; hasta ~1,3 ≈ Evo 2 (D2)
cylinders = 4             # solo para el sonido del motor (tarea 2.7)

# Par sin presión (N·m) por rpm: el 45 % del de plena presión (estimado). A plena presión
# (× 2,222): 240 a 1000, 450 a 5000 (fuente: 332 lb-ft) y 307 a 8000 rpm (257 kW, fuente).
# Entre 7500 y 8000 rpm la potencia queda plana en 257 kW.
[engine.torque]
1000 = 108
2000 = 148.5
3000 = 175.5
4000 = 193.5
5000 = 202.5
6000 = 171
7000 = 155.25
7500 = 147.15
8000 = 138.15
8200 = 130.5

# Turbo KKK K26: presión de primer orden hacia un objetivo que depende de las rpm y del
# acelerador, sin antirretardo.
[turbo]
max_boost_bar = 1.45      # válvula de descarga. Fuente (1,4-1,5)
boost_gain_per_bar = 0.8429 # g en T = T_atm·(1 + g·p): (1/0,45 - 1)/1,45, el par sin presión es el 45 %
threshold_rpm = 3500      # por debajo, sin presión. Estimado
full_rpm = 5000           # desde aquí, objetivo pleno. Estimado
rise_time = 0.39          # s: constante de subida a rise_reference_rpm (90 % en 0,9 s). Estimado
rise_reference_rpm = 4500 # la constante de subida crece a bajas rpm (× 4500/rpm)
fall_time = 0.11          # s: constante de bajada (< 10 % en 0,25 s). Estimado

# Embrague automático interno: patina al arrancar, nunca cala.
[clutch]
capacity_factor = 1.6     # × par máximo a plena presión × torque_scale (720 N·m). Estimado
bite_fraction = 0.15      # en arranque, la capacidad muerde hasta el 15 % antes de la rampa (por debajo del par del motor): arranca sin esperar a que suban las vueltas. Valor de partida
engage_rpm = 1200         # en arranque, capacidad 0 por debajo: sin avance lento al ralentí. Estimado
launch_rpm = 4500         # rpm del arranque a fondo, por encima del umbral del turbo. Estimado
launch_ramp_rpm = 500     # rampa de la capacidad en arranque. Estimado
open_rpm = 1250           # cerrado vuelve a arranque por debajo (nunca cala). Estimado

# Caja de 5 marchas (fuente: 5 marchas, desarrollos cortos). Relaciones totales, con el grupo,
# estimadas para 1ª a ~65 km/h y 5ª a ~210 km/h a 8200 rpm (rueda de 0,31 m), en progresión
# geométrica: 65, 87, 117, 157 y 210 km/h.
[gearbox]
reverse = 13.5            # Estimado
gear_1 = 14.75
gear_2 = 11.0
gear_3 = 8.2
gear_4 = 6.12
gear_5 = 4.56
shift_time = 0.08         # s de corte en el cambio. Estimado
upshift_rpm_full = 7800   # automático: sube a fondo... Valor de partida, se ajusta en 2.10
upshift_rpm_closed = 6500 # ... y con el acelerador a 0 (lineal entre medias): al levantar el pie no sube (en la entrada de una curva conserva la marcha). Valor de partida
downshift_rpm_full = 4200 # baja a fondo. Valor de partida
downshift_rpm_closed = 2000 # baja con el acelerador a 0. Valor de partida
drift_hold_time = 0.75    # s: espera de la subida en derrape (rango cerrado 0,5-1 s)
drift_angle_deg = 10      # |β| desde el que el automático ve derrape. Estimado

# Diferencial central de reparto fijo con viscoacoplador y autoblocantes de rampa.
[driveline]
front_share = 0.33        # reparto 33/67. Fuente (Evo 1)
viscous = 20              # N·m·s/rad entre ejes. Valor de partida: el criterio 8 de la 2.6 (≥ 20 % más al eje que agarra) da 48,6 % delante con |Δω| ≤ 29 rad/s; de 10 a 60 el reparto apenas cambia (45-49 %)
lsd_front_preload = 50    # N·m. Estimado
lsd_front_drive = 0.30    # par de bloqueo / par de entrada al eje, acelerando. Estimado
lsd_front_coast = 0.20    # ... reteniendo. Estimado
lsd_rear_preload = 80     # N·m. Estimado
lsd_rear_drive = 0.50     # Estimado
lsd_rear_coast = 0.30     # Estimado

[driver]
eye_left = 0.37           # m a la izquierda del eje del coche. Estimado
eye_height = 1.05         # m sobre el suelo. Estimado
eye_behind_front_axle = 1.00 # m. Estimado

# Interior provisional (tarea 2.7; solo presentación, la simulación no lo lee). Metros relativos
# al ojo nominal de [driver], sin el asiento del jugador. Medidas aproximadas de un 205 (prompt de la 2.7); verificar con fotos.
[cockpit]
windshield_base_ahead = 0.70   # base del parabrisas, por delante del ojo. Aproximado, de un 205
windshield_base_below = 0.30   # ... y por debajo. Aproximado, de un 205
windshield_top_ahead = 0.55    # borde superior del parabrisas. Aproximado, de un 205
windshield_top_above = 0.15    # Aproximado, de un 205
pillar_width = 0.08            # montantes del parabrisas. Aproximado, de un 205
pillar_left = 0.25             # centro del montante izquierdo, a la izquierda del ojo. Aproximado, de un 205
pillar_right = 1.05            # centro del montante derecho, a la derecha del ojo. Aproximado, de un 205
roof_above = 0.18              # techo sobre el ojo. Estimado
roof_behind = 0.60             # el techo llega hasta aquí por detrás del ojo. Estimado
door_left = 0.31               # cara interior de la puerta izquierda (1,35 m de ancho interior). Estimado
door_right = 1.04              # ... y de la derecha. Estimado
sill_below = 0.28              # borde de abajo de la ventanilla lateral. Estimado
dash_rear_ahead = 0.50         # borde trasero del salpicadero. Estimado
wheel_ahead = 0.45             # centro del volante. Aproximado, de un 205
wheel_diameter = 0.35          # Aproximado, de un 205
wheel_center_below = 0.35      # con la inclinación, el borde superior queda a −25° (se ve). Estimado
wheel_tilt_deg = 20            # aro inclinado, arriba hacia atrás. Estimado
steering_ratio = 13            # 13:1, unas 2,2 vueltas de tope a tope con 30°. Aproximado, de un 205
display_ahead = 0.60           # pantalla de marcha, rpm y presión. Estimado
display_below = 0.24           # Estimado
display_right = 0.0            # Estimado
display_width = 0.16           # Estimado
display_height = 0.06          # Estimado
